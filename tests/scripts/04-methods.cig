stick s = "  Hello, World  "
exhale s.trim().lower(), s.len(), s.trim().split(", "), s.contains("World"), s.trim().starts_with("He")
exhale "a-b-c".replace("-", "+"), "abc".find("c"), "abc".find("z"), "abcdef".slice(1, 3), "abcdef".slice(-2)
exhale "x".pad_left(3, "0"), "x".pad_right(3), "abc".reverse(), "a\nb".lines(), "abc".chars()
stick l = [3, 1, 2]
exhale l.sort(), l.reverse(), l.first(), l.last(), l.get(9, "dflt"), l.contains(2), l.index_of(2), l.slice(1)
exhale l.sum(), l.min(), l.max(), l.join("-"), [1, 1, 2].unique(), l.zip(["a", "b", "c"]), l.enumerate()
exhale [1, 2, 3, 4, 5].chunks(2), l.filter(pack(x) => x > 1), l.reduce(pack(a, b) => a * b, 1), l.any(pack(x) => x > 2), l.all(pack(x) => x > 2)
exhale l.find(pack(x) => x == 2), l.copy() == l, l.len()
stick m = {b: 2, a: 1}
exhale m.keys(), m.values(), m.entries(), m.has("a"), m.get("z", 0), m.merge({c: 3}), m.len()
m.set("d", 4)
m.remove("b")
exhale m, keys(m), values(m), entries(m)
roll l2 = [1, 2, 3]
l2.insert(0, 0)
exhale l2.pop(), l2.remove(0), l2
