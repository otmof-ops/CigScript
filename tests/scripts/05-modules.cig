exhale json.stringify({a: [1, 2.5, "x", null, true]}), json.parse('{"k": [1]}').k
exhale json.stringify({a: 1}, true)
exhale path.join("a", "b", "c.txt"), path.base("/x/y.tar.gz"), path.dir("/x/y"), path.ext("a.txt"), path.stem("a.txt")
exhale path.with_ext("a.txt", "md"), path.normalize("a/./b/../c"), path.is_abs("/a"), path.parts("a/b")
exhale text.matches("cig42", '\d+'), text.find("no digits", '\d+'), text.find_all("1 2 3", '\d'), text.captures("k=v", '(\w)=(\w)')
exhale text.replace("a1b22", '\d+', "#"), text.split("a, b,c", ',\s*'), text.template("hi {{ name }}", {name: "x"})
exhale hash.sha256("abc"), hash.short("abc"), hash.short("abc", 4)
exhale math.abs(-2), math.min(3, 1, 2), math.max([3, 1, 2]), math.floor(2.7), math.ceil(2.1), math.round(2.5), math.round(2.345, 2)
exhale math.sqrt(16), math.pow(2, 10), math.pow(2, 0.5) > 1.41, math.clamp(15, 0, 10), math.pi > 3.14
exhale csv.parse("a,b\n1,\"x,y\"\n"), csv.parse("h1,h2\n1,2\n", {header: true})
exhale csv.stringify([["a", "b,c"], ["1", "2"]])
exhale csv.stringify([{h: 1, k: "q\"q"}])
exhale time.format_ms(0), time.format_ms(86400000, "%Y-%m-%d")
exhale env.get("CIG_TEST_MISSING_VAR", "fallback"), env.has("PATH"), proc.which("definitely-not-a-real-binary-xyz")
