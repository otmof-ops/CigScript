    "kind": {
      "type": "string",
      "enum": [
        "lex",
        "syntax",
        "check",
        "type",
        "runtime",
        "cough",
        "burn",
        "usage",
        "internal"
      ]
    },
    "message": {
      "type": "string"
    },
    "hint": {
      "type": "string",
      "description": "what to type next"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "col": {
      "type": "integer",
      "minimum": 1
    },
    "subject": {
      "type": "string",
      "description": "the path, program, run id or name the message is about"
    },
    "file": {
      "type": "string"
    },
    "diagnosis": {
      "$ref": "#/$defs/diagnosis"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "family": {
      "type": "string",
      "enum": [
        "lex",
        "syntax",
        "check",
        "type",
        "runtime",
        "ghost",
        "hop",
        "blacklist",
        "cough",
        "kernel",
        "fold",
        "guard",
        "usage",
        "update",
        "finding",
        "internal",
        "build",
        "strength",
        "types",
        "layers",
        "ownership",
        "foreign",
        "carton"
      ]
    },
    "no": {
      "type": "string",
      "enum": [
        "none",
        "cant-see-any",
        "never-heard-of-you",
        "these-are-mine",
        "dont-have-any",
        "depends"
      ]
    },
    "diagnosis": {
      "type": "object",
      "description": "doctor's read-only diagnosis, when it fired: verdict, why, fix, and what to check if that is not it",
      "required": [
        "code",
        "confirmed",
        "verdict",
        "why",
        "fix",
        "if_not",
        "probes",
        "ms"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "confirmed": {
          "type": "boolean"
        },
        "verdict": {
          "type": "string"
        },
        "no": {
          "$ref": "#/$defs/no"
        },
        "ms": {
          "type": "integer",
          "minimum": 0
        },
        "why": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fix": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "if_not": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "probes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "check_report": {
      "type": "object",
      "description": "what `cig --json check <file>` prints",
      "required": [
        "file",
        "ok",
        "errors",
        "warnings"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      }
    }
  }
}
